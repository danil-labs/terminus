{
  "version": 1,
  "name": "secrets",
  "description": "Secretos genéricos env_secret (docs/account-credentials.md § Secretos genéricos). Fuera de la huella de commands.json: un motor sin esta capacidad no la anuncia en status.service_features. Ningún comando devuelve el valor salvo secret run, a la tarea dueña.",
  "features": [
    "secrets_v1"
  ],
  "commands": [
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "env_secret_set",
      "output": "-> Result < EnvSecretSaved , Failure >",
      "parameters": [
        {
          "key": "folder",
          "name": "folder",
          "type": "String"
        },
        {
          "key": "name",
          "name": "name",
          "type": "String"
        },
        {
          "key": "value",
          "name": "value",
          "type": "String"
        },
        {
          "key": "replace",
          "name": "replace",
          "type": "Option < bool >"
        }
      ],
      "path": "env_secrets::env_secret_set",
      "relay": false,
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "env_secret_remove",
      "output": "-> Result < EnvSecretRemoved , Failure >",
      "parameters": [
        {
          "key": "folder",
          "name": "folder",
          "type": "String"
        },
        {
          "key": "name",
          "name": "name",
          "type": "String"
        }
      ],
      "path": "env_secrets::env_secret_remove",
      "relay": false,
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "env_secrets_list",
      "output": "-> Result < EnvSecretsList , Failure >",
      "parameters": [],
      "path": "env_secrets::env_secrets_list",
      "scope": "workspace",
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "kind": "cli",
      "name": "secret run",
      "path": "secret run",
      "flags": [
        "command@"
      ],
      "writes": false,
      "audience": "public",
      "authority": "task",
      "durable": false,
      "relay": false,
      "enforcement": "server"
    }
  ]
}
