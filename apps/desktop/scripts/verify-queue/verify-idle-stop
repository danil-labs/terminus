#!/bin/bash
# Apaga la VM tras 30 minutos sin corrida ni sesión.
f=/run/verify-last-active
# En horario laboral sigue encendida: el equipo no puede encenderla sin credenciales de AWS.
d=$(TZ=America/Mexico_City date +%u); h=$(TZ=America/Mexico_City date +%-H)
if [ "$d" -le 5 ] && [ "$h" -ge 8 ] && [ "$h" -lt 19 ]; then touch "$f"; exit 0; fi
if [ -e /var/lib/verify-queue/busy ] || pgrep -f 'verify.mjs|cargo|rustc' >/dev/null || [ -n "$(who)" ] || [ ! -e "$f" ]; then touch "$f"; exit 0; fi
[ $(( $(date +%s) - $(stat -c %Y "$f") )) -gt 1800 ] && /sbin/shutdown -h now
