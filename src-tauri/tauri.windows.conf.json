{
  "build": {
    "beforeBuildCommand": "pnpm build && pnpm engine:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Terminus",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/seldon-runtime"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
