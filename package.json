{
  "name": "terminus-monorepo",
  "private": true,
  "description": "Terminus: the desktop app (apps/desktop), the mobile app (apps/mobile) and what they share (packages/).",
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "build": "pnpm -C apps/desktop build",
    "verify": "pnpm -C apps/desktop verify",
    "lint": "pnpm -C apps/desktop lint",
    "tauri": "pnpm -C apps/desktop tauri",
    "desktop:build": "pnpm -C apps/desktop desktop:build",
    "window:build": "pnpm -C apps/desktop window:build",
    "engine:download": "pnpm -C apps/desktop engine:download",
    "engine:sidecar": "pnpm -C apps/desktop engine:sidecar",
    "engine:start": "pnpm -C apps/desktop engine:start",
    "engine:stop": "pnpm -C apps/desktop engine:stop",
    "indicators": "pnpm -C apps/desktop indicators",
    "phrases": "pnpm -C apps/desktop phrases",
    "icons": "pnpm -C apps/desktop icons",
    "version:bump": "pnpm -C apps/desktop version:bump"
  }
}
